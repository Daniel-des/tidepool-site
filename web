    <div class="container">
      <div class="footer-inner">
        <div>
          <div class="footer-logo">TIDE<span>POOL</span></div>
          <div class="las-vegas-badge">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1" opacity="0.5"/><circle cx="5" cy="5" r="1.5" fill="currentColor" opacity="0.5"/></svg>
            Las Vegas, Nevada — MVP v1.0
          </div>
        </div>
        <div class="footer-meta">
          <div style="margin-bottom:6px;">Private network · Invitation only</div>
          <div>Swimming · Tennis · Golf</div>
        </div>
        <div class="footer-links">
          <a href="#how">How it works</a>
          <a href="#coaches">Coaches</a>
          <a href="#fees">Fees</a>
          <a href="mailto:hello@tidepool.app">Contact</a>
