<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tidepool — Elite Coaching Network</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:   #060d1a;
      --deep:   #0b1626;
      --panel:  #0f1e35;
      --teal:   #0e8a8a;
      --teal2:  #12a8a8;
      --tide:   #1cc8c8;
      --gold:   #c8a96e;
      --white:  #f4f4f2;
      --muted:  #8a9bb0;
      --border: rgba(255,255,255,0.07);
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--navy);
      color: var(--white);
      font-family: 'Inter', sans-serif;
      font-weight: 300;
      line-height: 1.7;
      overflow-x: hidden;
    }

    /* ── NOISE TEXTURE OVERLAY ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
    }

    /* ── UTILITIES ── */
    .serif { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; }
    .serif-italic { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; }
    .teal { color: var(--tide); }
    .gold { color: var(--gold); }
    .muted { color: var(--muted); }

    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 32px;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--tide);
      margin-bottom: 20px;
    }
    .tag::before {
      content: '';
      display: block;
      width: 20px;
      height: 1px;
      background: var(--tide);
    }

    /* ── NAV ── */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 20px 0;
      transition: background 0.3s, border-color 0.3s;
      border-bottom: 1px solid transparent;
    }
    nav.scrolled {
      background: rgba(6, 13, 26, 0.92);
      backdrop-filter: blur(16px);
      border-color: var(--border);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .logo {
      font-family: 'Instrument Serif', serif;
      font-size: 22px;
      letter-spacing: 0.08em;
      color: var(--white);
      text-decoration: none;
    }
    .logo span { color: var(--tide); }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 36px;
      list-style: none;
    }
    .nav-links a {
      color: var(--muted);
      text-decoration: none;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.03em;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--white); }
    .btn-nav {
      background: transparent;
      border: 1px solid var(--teal);
      color: var(--tide) !important;
      padding: 9px 22px;
      border-radius: 4px;
      font-size: 12px !important;
      font-weight: 500 !important;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: background 0.2s, color 0.2s !important;
    }
    .btn-nav:hover {
      background: var(--teal) !important;
      color: var(--navy) !important;
    }
    .nav-mobile-toggle { display: none; cursor: pointer; }

    /* ── HERO ── */
    #hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      padding: 120px 0 80px;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 70% 60% at 60% 50%, rgba(14, 138, 138, 0.12) 0%, transparent 70%),
        radial-gradient(ellipse 40% 50% at 20% 80%, rgba(12, 168, 168, 0.07) 0%, transparent 60%);
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      position: relative;
      z-index: 1;
    }
    .hero-eyebrow {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .hero-eyebrow::before {
      content: '';
      display: block;
      width: 28px;
      height: 1px;
      background: var(--gold);
    }
    .hero h1 {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(48px, 5.5vw, 76px);
      line-height: 1.05;
      letter-spacing: -0.01em;
      margin-bottom: 28px;
    }
    .hero h1 em {
      font-style: italic;
      color: var(--tide);
    }
    .hero-sub {
      font-size: 17px;
      color: var(--muted);
      max-width: 440px;
      margin-bottom: 48px;
      line-height: 1.8;
    }
    .hero-ctas {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: var(--teal);
      color: var(--navy);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 15px 30px;
      border-radius: 4px;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
    }
    .btn-primary:hover { background: var(--tide); transform: translateY(-1px); }
    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: transparent;
      color: var(--white);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 15px 30px;
      border-radius: 4px;
      border: 1px solid var(--border);
      text-decoration: none;
      transition: border-color 0.2s, transform 0.15s;
    }
    .btn-secondary:hover { border-color: rgba(255,255,255,0.25); transform: translateY(-1px); }
    .hero-visual {
      position: relative;
    }
    .hero-card-stack {
      position: relative;
      height: 420px;
    }
    .coach-card {
      position: absolute;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      width: 280px;
    }
    .coach-card:nth-child(1) {
      top: 0; left: 40px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.4);
    }
    .coach-card:nth-child(2) {
      top: 160px; left: 0;
      box-shadow: 0 24px 64px rgba(0,0,0,0.3);
      opacity: 0.7;
      transform: scale(0.96);
    }
    .coach-card:nth-child(3) {
      top: 60px; right: 0;
      background: linear-gradient(135deg, #0e2a3a 0%, #0f1e35 100%);
      border-color: rgba(14,138,138,0.3);
      box-shadow: 0 24px 64px rgba(0,0,0,0.4);
    }
    .card-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-family: 'Instrument Serif', serif;
      font-weight: 400;
    }
    .av-blue { background: rgba(14,138,138,0.2); color: var(--tide); }
    .av-gold { background: rgba(200,169,110,0.15); color: var(--gold); }
    .av-white { background: rgba(255,255,255,0.08); color: var(--white); }
    .card-name { font-size: 14px; font-weight: 500; margin-bottom: 4px; }
    .card-sport { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 12px; }
    .card-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 16px; }
    .badge {
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 2px;
    }
    .badge-teal { background: rgba(14,138,138,0.2); color: var(--tide); }
    .badge-gold { background: rgba(200,169,110,0.15); color: var(--gold); }
    .card-rate { font-size: 22px; font-family: 'Instrument Serif', serif; }
    .card-rate span { font-size: 12px; font-family: 'Inter', sans-serif; color: var(--muted); font-weight: 300; }
    .card-spots { font-size: 11px; color: var(--teal2); margin-top: 6px; }
    .card-full { font-size: 11px; color: var(--muted); margin-top: 6px; }
    .passive-pill {
      background: rgba(14,138,138,0.12);
      border: 1px solid rgba(14,138,138,0.25);
      border-radius: 8px;
      padding: 14px 16px;
    }
    .passive-label { font-size: 10px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
    .passive-amount { font-family: 'Instrument Serif', serif; font-size: 26px; color: var(--tide); }
    .passive-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }

    /* ── STATEMENT ── */
    #statement {
      padding: 100px 0;
      text-align: center;
      position: relative;
    }
    .statement-line {
      font-family: 'Instrument Serif', serif;
      font-style: italic;
      font-size: clamp(28px, 3.5vw, 46px);
      line-height: 1.3;
      max-width: 780px;
      margin: 0 auto 24px;
      color: var(--white);
    }
    .statement-attr {
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .divider {
      width: 60px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--teal), transparent);
      margin: 40px auto;
    }

    /* ── HOW IT WORKS ── */
    #how {
      padding: 100px 0;
      background: var(--deep);
      position: relative;
    }
    #how::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }
    .section-header {
      margin-bottom: 72px;
    }
    .section-title {
      font-family: 'Instrument Serif', serif;
      font-size: clamp(34px, 3.5vw, 50px);
      line-height: 1.1;
      margin-bottom: 16px;
    }
    .section-sub {
      font-size: 16px;
      color: var(--muted);
      max-width: 520px;
      line-height: 1.8;
    }
    .how-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
      background: var(--border);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }
    .how-step {
      background: var(--panel);
      padding: 40px 36px;
      position: relative;
    }
    .step-num {
      font-family: 'Instrument Serif', serif;
      font-size: 52px;
      color: rgba(14,138,138,0.12);
      position: absolute;
      top: 20px;
      right: 24px;
      line-height: 1;
    }
    .step-icon {
      width: 48px;
      height: 48px;
      border-radius: 8px;
      background: rgba(14,138,138,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      font-size: 22px;
    }
    .step-title {
      font-size: 17px;
      font-weight: 500;
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }
    .step-body {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.75;
    }

    /* ── COACHES ── */
    #coaches {
      padding: 120px 0;
    }
    .coaches-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .feature-list {
      list-style: none;
      margin-top: 36px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .feature-list li {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }
    .feature-icon {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      background: rgba(14,138,138,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
      font-size: 15px;
    }
    .feature-text strong {
      display: block;
      font-size: 15px;
      font-weight: 500;
      margin-bottom: 4px;
    }
    .feature-text p {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.7;
    }
    .earnings-visual {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px;
    }
    .earnings-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 28px;
    }
    .earnings-title { font-size: 13px; font-weight: 500; letter-spacing: 0.03em; }
    .earnings-period { font-size: 11px; color: var(--muted); }
    .earnings-total {
      font-family: 'Instrument Serif', serif;
      font-size: 44px;
      margin-bottom: 6px;
    }
    .earnings-sub { font-size: 12px; color: var(--muted); margin-bottom: 28px; }
    .bar-chart { display: flex; flex-direction: column; gap: 12px; }
    .bar-row { }
    .bar-label {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
    }
    .bar-label span:last-child { color: var(--white); font-weight: 500; }
    .bar-track {
      height: 6px;
      background: rgba(255,255,255,0.05);
      border-radius: 3px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 1s ease;
    }
    .bar-teal { background: linear-gradient(90deg, var(--teal), var(--tide)); }
    .bar-gold { background: linear-gradient(90deg, #a07840, var(--gold)); }
    .bar-muted { background: rgba(255,255,255,0.15); }
    .referral-note {
      margin-top: 24px;
      padding: 16px;
      background: rgba(14,138,138,0.08);
      border: 1px solid rgba(14,138,138,0.2);
      border-radius: 8px;
      font-size: 12px;
      color: var(--tide);
      line-height: 1.6;
    }

    /* ── PARENTS ── */
    #parents {
      padding: 120px 0;
      background: var(--deep);
    }
    #parents::before {
      content: '';
      display: block;
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }
    #parents { position: relative; }
    .parents-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .steps-visual { display: flex; flex-direction: column; gap: 0; }
    .flow-step {
      display: flex;
      gap: 20px;
      padding: 28px 0;
      border-bottom: 1px solid var(--border);
      position: relative;
    }
    .flow-step:last-child { border-bottom: none; }
    .flow-num {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(14,138,138,0.1);
      border: 1px solid rgba(14,138,138,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 500;
      color: var(--tide);
      flex-shrink: 0;
      margin-top: 2px;
    }
    .flow-content strong {
      display: block;
      font-size: 15px;
      font-weight: 500;
      margin-bottom: 6px;
    }
    .flow-content p {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.7;
    }
    .flow-note {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--gold);
      margin-top: 8px;
    }

    /* ── FEES ── */
    #fees {
      padding: 120px 0;
    }
    .fees-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 56px;
    }
    .fee-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 36px 32px;
      position: relative;
      overflow: hidden;
    }
    .fee-card.highlighted {
      border-color: rgba(14,138,138,0.4);
      background: linear-gradient(135deg, #0e2535 0%, #0f1e35 100%);
    }
    .fee-card.highlighted::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--teal), var(--tide));
    }
    .fee-scenario {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 20px;
    }
    .fee-title {
      font-family: 'Instrument Serif', serif;
      font-size: 22px;
      margin-bottom: 28px;
      line-height: 1.3;
    }
    .fee-splits { display: flex; flex-direction: column; gap: 12px; }
    .split-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
    }
    .split-who { color: var(--muted); }
    .split-pct { font-weight: 500; font-size: 18px; font-family: 'Instrument Serif', serif; }
    .split-pct.big { font-size: 28px; color: var(--tide); }
    .fee-footnote {
      margin-top: 24px;
      font-size: 11px;
      color: var(--muted);
      line-height: 1.6;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    /* ── SPORTS ── */
    #sports {
      padding: 100px 0;
      background: var(--deep);
      position: relative;
    }
    #sports::before {
      content: '';
      display: block;
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }
    .sports-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 56px;
    }
    .sport-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 44px 36px;
      text-align: center;
      transition: border-color 0.2s, transform 0.2s;
      cursor: default;
    }
    .sport-card:hover {
      border-color: rgba(14,138,138,0.35);
      transform: translateY(-4px);
    }
    .sport-emoji { font-size: 44px; margin-bottom: 20px; display: block; }
    .sport-name {
      font-family: 'Instrument Serif', serif;
      font-size: 22px;
      margin-bottom: 12px;
    }
    .sport-desc { font-size: 13px; color: var(--muted); line-height: 1.7; }
    .sport-status {
      margin-top: 20px;
      display: inline-block;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 2px;
    }
    .status-launch { background: rgba(14,138,138,0.15); color: var(--tide); }
    .status-expand { background: rgba(255,255,255,0.05); color: var(--muted); }

    /* ── NETWORK ── */
    #network {
      padding: 120px 0;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .network-bg {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 60% 70% at 50% 50%, rgba(14, 138, 138, 0.08) 0%, transparent 70%);
    }
    .network-content { position: relative; z-index: 1; max-width: 680px; margin: 0 auto; }
    .network-stat-row {
      display: flex;
      justify-content: center;
      gap: 60px;
      margin: 56px 0;
    }
    .network-stat { text-align: center; }
    .stat-num {
      font-family: 'Instrument Serif', serif;
      font-size: 52px;
      color: var(--tide);
      line-height: 1;
      margin-bottom: 10px;
    }
    .stat-label { font-size: 12px; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; }
    .network-quote {
      font-family: 'Instrument Serif', serif;
      font-style: italic;
      font-size: clamp(20px, 2.5vw, 28px);
      line-height: 1.5;
      color: var(--white);
      margin-bottom: 20px;
    }
    .network-quote-attr {
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* ── CTA ── */
    #cta {
      padding: 120px 0;
      background: var(--deep);
      position: relative;
    }
    #cta::before {
      content: '';
      display: block;
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border), transparent);
    }
    .cta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .cta-panel {
